    given-names: Tom
    affiliation: "Department of Chemistry, Lehman College, The City University of New York"
version: 0.1.0
date-released: "2026-10-26"
license:
  - MIT
  - Apache-2.0
repository-code: "https://github.com/helmutcarter/molentropy"
url: "https://helmutcarter.github.io/molentropy/"
keywords:
  - entropy
  - molecular dynamics
  - mutual information
  - quasi-harmonic analysis
